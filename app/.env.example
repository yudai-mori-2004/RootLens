EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-privy-client-id

# Sandbox 02 / 04 (VLM Task Gate) — provider keys
# 注意: EXPO_PUBLIC_* は JS bundle に inline されます。本番では backend proxy 経由にする。
# https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
# https://console.anthropic.com/settings/keys
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=

# Sandbox 04 — Title Protocol register
# Demo: Privy login をスキップして TP register の owner_wallet をここから読む。
# 自分の Solana wallet (devnet の Phantom 等の任意 pubkey) を入れる。
# 値なしの場合 Result 画面の "Mint Core NFT" CTA は disabled になる。
EXPO_PUBLIC_DEMO_WALLET_ADDRESS=

# 特定の Solana RPC に固定したい場合のみ。未設定時は helius devnet が使われる。
EXPO_PUBLIC_SOLANA_RPC_URL=
