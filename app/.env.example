# ──────────────────────────────────────────────────────────────────
# Privy (将来の embedded wallet ログイン用、現在の demo path では未使用)
# ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-privy-client-id

# ──────────────────────────────────────────────────────────────────
# Demo wallet (Privy login を skip して固定 wallet で動かす)
# ──────────────────────────────────────────────────────────────────

# Demo モードの Solana wallet pubkey (base58)。Unit B の owner_wallet 引数に渡る。
# 値なしの場合 Login 画面が "no wallet" 表示になり進めない。
EXPO_PUBLIC_DEMO_WALLET_ADDRESS=

# Demo モードの secret key (base58 64 byte)。Unit G の stake tx 署名に必要。
# 上の pubkey と一致させること。値なしの場合 Stake は disabled (skip 可能)。
# WARNING: bundle に inline されるので絶対 production には載せない。
EXPO_PUBLIC_DEMO_KEYPAIR_BASE58=

# ──────────────────────────────────────────────────────────────────
# Solana / Stake 先
# ──────────────────────────────────────────────────────────────────

# 特定の Solana RPC に固定したい場合のみ。未設定時は公式 devnet (api.devnet.solana.com)。
# Helius は devnet サポートが縮退したので公式 RPC を default にしている。
EXPO_PUBLIC_SOLANA_RPC_URL=

# DAS (Bubblegum cNFT 検索) endpoint。未設定時は SOLANA_RPC_URL と同じ。
# Solana 公式 devnet RPC は DAS API (getAssetsByOwner / getAsset 等) も提供している。
EXPO_PUBLIC_DAS_URL=

# Stake 先の cosign authority (Unit E が co-sign 時に使う pubkey, base58)。
# 値なしの場合 Stake 画面で stake ボタンが disabled になる (skip は可)。
EXPO_PUBLIC_COSIGN_AUTHORITY=
