# RootLens iOS app — env テンプレート。 src/env.ts と 1:1 対応。
# 自分の .env にコピーして値を埋めること。

# ─── required (未設定で起動失敗) ───────────────────────────────────────

# Anthropic API key (= 撮影中の VLM gate Step 2 / Step 6 で Claude に直接送る)。
# WARNING: bundle 解析で抜き取り可能。 dev/demo 用前提、 本番は server proxy 化。
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# RootLens 運営側 cosign delegate pubkey (= staking 時に Bubblegum delegate を委譲する先)。
EXPO_PUBLIC_COSIGN_AUTHORITY=

# Bubblegum cNFT 発行先 merkle tree (= Pipeline 1 step 6 で必須)。
EXPO_PUBLIC_MERKLE_TREE=
# Optional: MPL Core collection (= public tree なら省略可)
# EXPO_PUBLIC_MERKLE_COLLECTION=

# ─── optional (default で動く) ─────────────────────────────────────────

# 起点を DevSandbox にする (= dataflow 層の単体検証ハーネス)。 既定は本番 UI (RootNavigator)。
# 1 の時だけ DevSandbox を起点にする。 ⚠ build 時 inline のため値変更には rebuild が要る。
# EXPO_PUBLIC_USE_SANDBOX=1

# Solana RPC URL (default = https://api.devnet.solana.com、 DAS API も同居)。
# Helius / QuickNode 等を使う場合のみセット。
# EXPO_PUBLIC_SOLANA_RPC_URL=

# rootlens-server base URL (default = https://www.rootlens.io)。 ローカル dev で上書き。
# EXPO_PUBLIC_SERVER_URL=http://192.168.x.x:3000

# Title Protocol Gateway URL (= legacy/DevSandbox の直叩き用。 本流は web proxy 経由)。
# 固定 IP はハードコードしない (= EC2 再起動で変わる)。 直叩きする時だけ設定する。
# EXPO_PUBLIC_TP_GATEWAY_ENDPOINT=

# ─── debug ─────────────────────────────────────────────────────────────

# DebugAuthProvider の wallet を env で固定 (= 64 byte base58 secret)。
# 未設定なら SecureStore から復元 or 新規生成。
# EXPO_PUBLIC_DEBUG_WALLET_BASE58=

# Buyer simulator (BuyerScreen) を有効化したい場合のみ両方セット。
# EXPO_PUBLIC_BUYER_WALLET_ADDRESS=
# EXPO_PUBLIC_BUYER_KEYPAIR_BASE58=
