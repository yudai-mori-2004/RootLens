# RootLens iOS app — env テンプレート。 src/env.ts と 1:1 対応。
# 自分の .env にコピーして値を埋めること。 すべて optional (= default で動く)。

# 起点を DevSandbox にする (= dataflow 層の単体検証ハーネス)。 既定は本番 UI (RootNavigator)。
# 1 の時だけ DevSandbox を起点にする。 ⚠ build 時 inline のため値変更には rebuild が要る。
# EXPO_PUBLIC_USE_SANDBOX=1

# rootlens-server の base URL。 既定は本番 (https://www.rootlens.io)。
# local dev で別ホストを使う場合だけ上書きする。
# EXPO_PUBLIC_SERVER_URL=http://192.168.x.x:3000

# DebugAuthProvider のアカウント鍵を固定する (= 64 byte base58 secret)。
# 未設定なら端末の SecureStore から復元 or 新規生成する。 共有アカウントで smoke する時に使う。
# EXPO_PUBLIC_DEBUG_ACCOUNT_BASE58=

# Supabase Auth (task 13)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
