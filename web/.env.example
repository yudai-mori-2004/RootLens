# ===========================================
# RootLens Web — 環境変数
# ===========================================

# --- Supabase (クライアント: shortId解決) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (サーバー: ページ・コンテンツ書き込み) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- DAS API (クライアント: cNFT検索・検証) ---
NEXT_PUBLIC_DAS_RPC_URL=https://devnet.helius-rpc.com/?api-key=xxx

# --- Solana RPC (サーバー: Title Protocol登録) ---
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Cloudflare R2 (サーバー: 画像アップロード) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=rootlens-public
R2_PUBLIC_URL=

# --- Root CA (サーバー: デバイス証明書発行) ---
ROOT_CA_CERT_PEM=
ROOT_CA_KEY_PEM=

# --- Operator Wallet (サーバー: Title Protocol devnet登録) ---
OPERATOR_WALLET_JSON=

# --- Co-sign API (Unit E / SPECS_JA §5.3) ---
# Solana RPC endpoint (Config PDA を読むのに使う)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Helius / Triton DAS endpoint (cNFT proof 取得)
DAS_RPC_URL=
# License NFT Anchor program (network.json と同期)
LICENSE_NFT_PROGRAM_ID=G1PWd1nMe63isDaYT3iijcyWac9d4RE1CBrvaKZFjpV8
LICENSE_NFT_CONFIG_PDA=FfsaBAMBuDpWXaBKU8hCXMqtnjH4BFcwzW3EL7fhzx7U
# RootLens 専用 License Merkle Tree (create_license_tree で作った tree pubkey)
LICENSE_MERKLE_TREE=
# Delegate keypair (dev 用、ed25519 64B base58)。本番は KMS に差し替え
COSIGN_DELEGATE_PRIVATE_KEY_BASE58=
# 価格 catalog (yaml)
COSIGN_CATALOG_PATH=./config/cosign-catalog.yaml
# License NFT のメタデータ name (任意)
LICENSE_NAME=RootLens License
