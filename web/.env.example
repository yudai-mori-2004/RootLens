# ===========================================
# RootLens Web — 環境変数
# ===========================================

# --- Supabase (クライアント: shortId解決) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (サーバー: ページ・コンテンツ書き込み) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- DAS API (クライアント: cNFT検索・検証) ---
NEXT_PUBLIC_DAS_RPC_URL=https://devnet.helius-rpc.com/?api-key=xxx

# --- Solana RPC (サーバー: Title Protocol登録) ---
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Cloudflare R2 (サーバー: 画像アップロード + Pipeline 1/2/3) ---
# v0.1.2: R2_PUBLIC_BUCKET = LP / 公開アセット用
# v0.1.3: R2_BUCKET_RAW = 端末アップロード (= 非公開)、 R2_BUCKET_DATASETS = Pipeline 3 出力 (= 買い手配信)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=rootlens-public
R2_PUBLIC_URL=
R2_BUCKET_RAW=rootlens-raw
R2_BUCKET_DATASETS=rootlens-datasets

# --- VLM gate (Unit H / SPECS §2.3 step 3,6) ---
# 1 個以上設定する。default provider は claude。device には絶対 expose しない
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Root CA (サーバー: デバイス証明書発行) ---
# cert は公開物なので env、Root CA 秘密鍵は本リポでは使わない (Intermediate CA
# のみで device cert を発行する、Root CA 鍵は別管理)
ROOT_CA_CERT_PEM=

# --- Intermediate CA (秘密鍵は keys/ 配下) ---
# cert は env、key は keys/{ios,android}-intermediate-ca.key.pem
IOS_INTERMEDIATE_CA_CERT_PEM=
ANDROID_INTERMEDIATE_CA_CERT_PEM=

# --- Operator Wallet (サーバー: Title Protocol devnet登録) ---
OPERATOR_WALLET_JSON=

# --- License Issue API (Unit E / SPECS_JA §5.3) ---
# delegate 秘密鍵は keys/cosign-delegate.json (env にはキー値を持たない)
LICENSE_NFT_PROGRAM_ID=G1PWd1nMe63isDaYT3iijcyWac9d4RE1CBrvaKZFjpV8
LICENSE_NFT_CONFIG_PDA=FfsaBAMBuDpWXaBKU8hCXMqtnjH4BFcwzW3EL7fhzx7U
LICENSE_MERKLE_TREE=
# Address Lookup Table (issue_license tx を 1232B v0 に収めるため。 setup-alt.ts で作成)
LICENSE_NFT_ALT=
COSIGN_CATALOG_PATH=./config/cosign-catalog.yaml
LICENSE_NAME=RootLens License

# ===========================================
# v0.1.3 Data Pipeline (= DATA_SPECS_JA §3)
# ===========================================
# 撮影者が「送る」 押下した後の Pipeline 2 (= サーバ自動) と Pipeline 3 (= 手動トリガ) で使う。
# 詳細仕様: document/v0.1.3/DATA_SPECS_JA.md + document/v0.1.3/tasks/

# --- DB (Supabase) ---
# postgres-js + drizzle-orm/postgres-js から直接 TCP 接続する。
# Supabase の Transaction Pooler URL を使う (= IPv4 対応、 port 6543)。
# 形式: postgresql://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Modal endpoints (= Pipeline 2 + 3) ---
# 各 Modal 関数の web endpoint URL。 modal deploy 後に出力される URL を貼る。
# v0.1.3/modal/ 配下:
#   layer1_metadata.py     = 第 1 層 (sensors.jsonl + imu_high_rate.jsonl で 20 点)
#   layer2_frame_sampling.py = 第 2 層 (フレームサンプル画像解析で 15 点)
#   layer3_vlm.py          = 第 3 層 (Claude Haiku 4.5 で 55 点)
#   gtsam_eval.py          = GTSAM Video-IMU 整合性 (= 10 点)
#   bundle.py              = Pipeline 3 (WiLoR + LeRobot v3 dataset 構築)
MODAL_METADATA_ENDPOINT=
MODAL_FRAME_SAMPLING_ENDPOINT=
MODAL_VLM_ENDPOINT=
MODAL_GTSAM_ENDPOINT=
MODAL_BUNDLE_ENDPOINT=

# --- Title Protocol (= Root NFT 発行) ---
# devnet | mainnet
TP_NETWORK=devnet

# --- ToS (= TP register の extensionInputs に焼き込む) ---
# 公開済 ToS 文書の version 文字列 + その SHA-256 hex。 撮影者の同意 chain の根拠。
ROOTLENS_TOS_VERSION=
ROOTLENS_TOS_HASH=

# --- ステーキング delegate (= Bubblegum delegate に設定する RootLens の co-sign pubkey) ---
# 撮影者が「ステーキング」 した時の delegate 先。 base58 Solana pubkey。
ROOTLENS_COSIGN_DELEGATE=

# --- Push 通知 (= Pipeline 2 完了通知、 expo-notifications APNs 経由) ---
# 後段で実装。 APNs Auth Key 関連
APPLE_PUSH_TEAM_ID=
APPLE_PUSH_KEY_ID=
APPLE_PUSH_KEY=
