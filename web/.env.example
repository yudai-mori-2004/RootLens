# ===========================================
# RootLens Web — 環境変数
# ===========================================

# --- Supabase (クライアント: shortId解決) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (サーバー: ページ・コンテンツ書き込み) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- DAS API (クライアント: cNFT検索・検証) ---
NEXT_PUBLIC_DAS_RPC_URL=https://devnet.helius-rpc.com/?api-key=xxx

# --- Solana RPC (サーバー: Title Protocol登録) ---
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Cloudflare R2 (サーバー: 画像アップロード) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=rootlens-public
R2_PUBLIC_URL=

# --- VLM gate (Unit H / SPECS §2.3 step 3,6) ---
# 1 個以上設定する。default provider は claude。device には絶対 expose しない
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Root CA (サーバー: デバイス証明書発行) ---
# cert は公開物なので env、Root CA 秘密鍵は本リポでは使わない (Intermediate CA
# のみで device cert を発行する、Root CA 鍵は別管理)
ROOT_CA_CERT_PEM=

# --- Intermediate CA (秘密鍵は keys/ 配下) ---
# cert は env、key は keys/{ios,android}-intermediate-ca.key.pem
IOS_INTERMEDIATE_CA_CERT_PEM=
ANDROID_INTERMEDIATE_CA_CERT_PEM=

# --- Operator Wallet (サーバー: Title Protocol devnet登録) ---
OPERATOR_WALLET_JSON=

# --- License Issue API (Unit E / SPECS_JA §5.3) ---
# delegate 秘密鍵は keys/cosign-delegate.json (env にはキー値を持たない)
LICENSE_NFT_PROGRAM_ID=G1PWd1nMe63isDaYT3iijcyWac9d4RE1CBrvaKZFjpV8
LICENSE_NFT_CONFIG_PDA=FfsaBAMBuDpWXaBKU8hCXMqtnjH4BFcwzW3EL7fhzx7U
LICENSE_MERKLE_TREE=
# Address Lookup Table (issue_license tx を 1232B v0 に収めるため。 setup-alt.ts で作成)
LICENSE_NFT_ALT=
COSIGN_CATALOG_PATH=./config/cosign-catalog.yaml
LICENSE_NAME=RootLens License
