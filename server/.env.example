# rootlens-server 環境変数テンプレート。
# 実値は .env.local (= gitignore 済) に置く、 もしくは Vercel dashboard の env vars に登録する。

# ─── Database (Neon Postgres) ─────────────────────────────────────────
# Vercel Marketplace 経由で Neon を provision すると自動で set される。
# Format: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ─── Cloudflare R2 (object storage) ───────────────────────────────────
# 既存 web/ 側と同じ R2 account / credential を共有する。
# .env に R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY が既に設定済なら
# server/ 側でも自動で読まれる。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# server/ 専用のバケット名 (= 既存 rootlens-public とは別に用途分離)
R2_BUCKET_RAW=rootlens-mcap-raw
R2_BUCKET_BLURRED=rootlens-mcap-blurred

# ─── Modal (GPU 関数) ──────────────────────────────────────────────────
# modal deploy で発行された web endpoint URL
MODAL_BLUR_ENDPOINT=

# ─── Title Protocol (Root NFT 発行) ────────────────────────────────────
# TP gateway は指定しない (= SDK が健全な TEE ノードからランダム選択する設計)。
# 切り替えは TP_NETWORK で行う (= devnet / mainnet、 デフォルト devnet)。
TP_NETWORK=devnet

# ─── Solana (License NFT co-sign、 DAS query) ─────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DAS_URL=
# サーバが License NFT co-sign に使う authority キーペア (base58)。
# クライアントの EXPO_PUBLIC_COSIGN_AUTHORITY と同じ鍵で問題ない (server も同じ権限を持つ)。
COSIGN_AUTHORITY_SECRET_KEY=

# ─── C2PA サーバ証明書 (= 派生 manifest 署名用) ──────────────────────
# PEM 形式の証明書 + private key。 改行は \n でエスケープして 1 行に。
C2PA_SERVER_CERT_PEM=
C2PA_SERVER_PRIVATE_KEY_PEM=

# ─── Expo Push (通知) ─────────────────────────────────────────────────
# Expo access token。 https://expo.dev/accounts/[org]/settings/access-tokens
EXPO_ACCESS_TOKEN=
