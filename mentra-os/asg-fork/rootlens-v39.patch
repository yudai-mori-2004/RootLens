@@ -0,0 +1,42 @@
+package com.mentra.asg_client.audio;
+
+import android.content.Context;
+import android.media.AudioManager;
+import android.util.Log;
+
+/** Converges the dedicated glasses feedback stream to its deterministic audible level. */
+public final class FeedbackVolumeController {
+    private static final String TAG = "FeedbackVolume";
+
+    private final AudioManager audioManager;
+
+    public FeedbackVolumeController(Context context) {
+        this((AudioManager) context.getApplicationContext().getSystemService(Context.AUDIO_SERVICE));
+    }
+
+    FeedbackVolumeController(AudioManager audioManager) {
+        this.audioManager = audioManager;
+    }
+
+    /**
+     * Ensure feedback is audible without accumulating state or applying relative adjustments.
+     *
+     * @return true only when this call changed the stream volume
+     */
+    public boolean ensureAudible() {
+        if (audioManager == null) {
+            Log.w(TAG, "AudioManager unavailable; cannot reconcile feedback volume");
+            return false;
+        }
+
+        int maximum = audioManager.getStreamMaxVolume(AudioManager.STREAM_NOTIFICATION);
+        int current = audioManager.getStreamVolume(AudioManager.STREAM_NOTIFICATION);
+        if (current == maximum) {
+            return false;
+        }
+
+        audioManager.setStreamVolume(AudioManager.STREAM_NOTIFICATION, maximum, 0);
+        Log.i(TAG, "Feedback volume reconciled: " + current + " -> " + maximum);
+        return true;
+    }
+}
