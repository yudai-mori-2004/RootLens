+/** Routes dedicated camera-button commands to an installed RootLens capture app. */
+final class RootLensCaptureControl {
+    private static final String TAG = "RootLensCaptureControl";
+    private static final String ACTION_TOGGLE = "io.rootlens.mentra.TOGGLE";
+    private static final String ACTION_UPLOAD = "io.rootlens.mentra.UPLOAD";
+    private static final String ACTION_CALIBRATE = "io.rootlens.mentra.CALIBRATE";
+    private static final String EXTRA_COMMAND_ID = "command_id";
+    private static final String RECEIVER_CLASS =
+            "io.rootlens.mentra.CaptureCommandReceiver";
+    private static final String[] ROOTLENS_PACKAGES = {
+            "io.rootlens.mentra",
+            "io.rootlens.mentra.debug"
+    };
+
+    private RootLensCaptureControl() {}
+
+    static boolean toggle(Context context, long pressElapsedNanos) {
+        Context appContext = context.getApplicationContext();
+        String packageName = activePackage(appContext.getPackageManager());
+        if (packageName == null) return false;
+
+        Intent command = new Intent(ACTION_TOGGLE)
+                .setComponent(new ComponentName(packageName, RECEIVER_CLASS))
+                .putExtra(EXTRA_COMMAND_ID, commandId(pressElapsedNanos));
+        try {
+            appContext.sendBroadcast(command);
+            Log.i(TAG, "Camera-button short press delivered to " + packageName);
+            return true;
+        } catch (RuntimeException error) {
+            Log.e(TAG, "Could not deliver camera-button short press", error);
+            return false;
+        }
+    }
+
+    static String commandId(long pressElapsedNanos) {
+        return "action-button-short:" + pressElapsedNanos;
+    }
+
+    static boolean upload(Context context, long pressElapsedNanos) {
+        Context appContext = context.getApplicationContext();
+        String packageName = activePackage(appContext.getPackageManager());
+        if (packageName == null) return false;
+
+        Intent command = new Intent(ACTION_UPLOAD)
+                .setComponent(new ComponentName(packageName, RECEIVER_CLASS))
+                .putExtra(EXTRA_COMMAND_ID, uploadCommandId(pressElapsedNanos));
+        try {
+            appContext.sendBroadcast(command);
+            Log.i(TAG, "Upload command delivered to " + packageName);
+            return true;
+        } catch (RuntimeException error) {
+            Log.e(TAG, "Could not deliver upload command", error);
+            return false;
+        }
+    }
+
+    static String uploadCommandId(long pressElapsedNanos) {
+        return "action-button-upload:" + pressElapsedNanos;
+    }
+
+    static boolean calibrate(Context context, long pressElapsedNanos) {
+        Context appContext = context.getApplicationContext();
+        String packageName = activePackage(appContext.getPackageManager());
+        if (packageName == null) return false;
+
+        Intent command = new Intent(ACTION_CALIBRATE)
+                .setComponent(new ComponentName(packageName, RECEIVER_CLASS))
+                .putExtra(EXTRA_COMMAND_ID, calibrationCommandId(pressElapsedNanos));
+        try {
+            appContext.sendBroadcast(command);
+            Log.i(TAG, "Hidden calibration command delivered to " + packageName);
+            return true;
+        } catch (RuntimeException error) {
+            Log.e(TAG, "Could not deliver hidden calibration command", error);
+            return false;
+        }
+    }
+
+    static String calibrationCommandId(long pressElapsedNanos) {
+        return "action-button-calibration:" + pressElapsedNanos;
+    }
+
+    private static String activePackage(PackageManager packageManager) {
+        for (String packageName : ROOTLENS_PACKAGES) {
+            if (isEnabled(packageManager, packageName)) return packageName;
+        }
+        return null;
+    }
+
+    private static boolean isEnabled(PackageManager packageManager, String packageName) {
+        try {
+            ApplicationInfo info = packageManager.getApplicationInfo(
+                    packageName, PackageManager.MATCH_DISABLED_COMPONENTS);
+            int state = packageManager.getApplicationEnabledSetting(packageName);
+            return info.enabled
+                    && state != PackageManager.COMPONENT_ENABLED_STATE_DISABLED
+                    && state != PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER
+                    && state != PackageManager.COMPONENT_ENABLED_STATE_DISABLED_UNTIL_USED;
+        } catch (PackageManager.NameNotFoundException ignored) {
+            return false;
+        }
+    }
+}
