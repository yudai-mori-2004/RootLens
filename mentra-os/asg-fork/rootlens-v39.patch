@@ -0,0 +1,222 @@
+package com.mentra.asg_client.service.core.handlers;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/** Pure policy for capture toggle, upload, and the five-press calibration gesture. */
+final class RootLensButtonReducer {
+    static final int REQUIRED_CALIBRATION_PRESSES = 5;
+    static final long SEQUENCE_TIMEOUT_NS = 30_000_000_000L;
+    static final long MAX_GAP_NS = 8_000_000_000L;
+    static final long DUPLICATE_GUARD_NS = 1_000_000_000L;
+
+    enum Phase { IDLE, WAITING_FOR_NEXT_LONG_PRESS }
+    enum EventType { LONG_PRESS, NORMAL_PRESS, TIMEOUT }
+    enum EffectType {
+        PLAY_STEP,
+        CANCEL_TIMEOUT,
+        ARM_TIMEOUT,
+        TOGGLE_CAPTURE,
+        START_UPLOAD,
+        START_CALIBRATION
+    }
+
+    static final class State {
+        final Phase phase;
+        final int pressCount;
+        final long firstPressNs;
+        final long lastPressNs;
+        final long deadlineNs;
+        final long revision;
+
+        private State(
+                Phase phase,
+                int pressCount,
+                long firstPressNs,
+                long lastPressNs,
+                long deadlineNs,
+                long revision) {
+            this.phase = phase;
+            this.pressCount = pressCount;
+            this.firstPressNs = firstPressNs;
+            this.lastPressNs = lastPressNs;
+            this.deadlineNs = deadlineNs;
+            this.revision = revision;
+        }
+
+        static State idle() {
+            return new State(Phase.IDLE, 0, 0L, 0L, 0L, 0L);
+        }
+    }
+
+    static final class Event {
+        final EventType type;
+        final long atNs;
+        final long revision;
+
+        private Event(EventType type, long atNs, long revision) {
+            this.type = type;
+            this.atNs = atNs;
+            this.revision = revision;
+        }
+
+        static Event longPress(long atNs) {
+            return new Event(EventType.LONG_PRESS, atNs, 0L);
+        }
+
+        static Event normalPress(long atNs) {
+            return new Event(EventType.NORMAL_PRESS, atNs, 0L);
+        }
+
+        static Event timeout(long revision, long atNs) {
+            return new Event(EventType.TIMEOUT, atNs, revision);
+        }
+    }
+
+    static final class Effect {
+        final EffectType type;
+        final long revision;
+        final long deadlineNs;
+        final long commandIdNs;
+
+        private Effect(
+                EffectType type, long revision, long deadlineNs, long commandIdNs) {
+            this.type = type;
+            this.revision = revision;
+            this.deadlineNs = deadlineNs;
+            this.commandIdNs = commandIdNs;
+        }
+
+        static Effect now(EffectType type) {
+            return new Effect(type, 0L, 0L, 0L);
+        }
+
+        static Effect command(EffectType type, long commandIdNs) {
+            return new Effect(type, 0L, 0L, commandIdNs);
+        }
+
+        static Effect arm(State state) {
+            return new Effect(
+                    EffectType.ARM_TIMEOUT, state.revision, state.deadlineNs, 0L);
+        }
+    }
+
+    static final class Transition {
+        final State state;
+        final List<Effect> effects;
+
+        Transition(State state, List<Effect> effects) {
+            this.state = state;
+            this.effects = effects;
+        }
+    }
+
+    static Transition reduce(State state, Event event) {
+        switch (event.type) {
+            case LONG_PRESS:
+                return longPress(state, event.atNs);
+            case NORMAL_PRESS:
+                return normalPress(state, event.atNs);
+            case TIMEOUT:
+                return timeout(state, event.revision, event.atNs);
+            default:
+                return unchanged(state);
+        }
+    }
+
+    private static Transition longPress(State state, long nowNs) {
+        if (state.phase == Phase.IDLE) return begin(state, nowNs, false);
+
+        long gapNs = nowNs - state.lastPressNs;
+        if (gapNs >= 0L && gapNs < DUPLICATE_GUARD_NS) return unchanged(state);
+        if (gapNs < 0L || nowNs > state.deadlineNs) return begin(state, nowNs, true);
+
+        int nextCount = state.pressCount + 1;
+        if (nextCount == REQUIRED_CALIBRATION_PRESSES) {
+            return transition(idleAfter(state),
+                    Effect.now(EffectType.CANCEL_TIMEOUT),
+                    Effect.now(EffectType.PLAY_STEP),
+                    Effect.command(EffectType.START_CALIBRATION, state.firstPressNs));
+        }
+
+        State next = waiting(
+                nextCount,
+                state.firstPressNs,
+                nowNs,
+                state.revision + 1L);
+        return transition(next,
+                Effect.now(EffectType.CANCEL_TIMEOUT),
+                Effect.now(EffectType.PLAY_STEP),
+                Effect.arm(next));
+    }
+
+    private static Transition normalPress(State state, long nowNs) {
+        if (state.phase == Phase.IDLE) {
+            return transition(state, Effect.command(EffectType.TOGGLE_CAPTURE, nowNs));
+        }
+        if (nowNs > state.deadlineNs) {
+            return transition(idleAfter(state),
+                    Effect.now(EffectType.CANCEL_TIMEOUT),
+                    Effect.command(EffectType.START_UPLOAD, state.firstPressNs),
+                    Effect.command(EffectType.TOGGLE_CAPTURE, nowNs));
+        }
+        return transition(idleAfter(state),
+                Effect.now(EffectType.CANCEL_TIMEOUT),
+                Effect.command(EffectType.TOGGLE_CAPTURE, nowNs));
+    }
+
+    private static Transition timeout(State state, long revision, long nowNs) {
+        if (state.phase != Phase.WAITING_FOR_NEXT_LONG_PRESS
+                || state.revision != revision) {
+            return unchanged(state);
+        }
+        if (nowNs <= state.deadlineNs) {
+            return transition(state, Effect.arm(state));
+        }
+        return transition(idleAfter(state),
+                Effect.command(EffectType.START_UPLOAD, state.firstPressNs));
+    }
+
+    private static Transition begin(State state, long nowNs, boolean uploadExpiredSequence) {
+        State next = waiting(1, nowNs, nowNs, state.revision + 1L);
+        if (uploadExpiredSequence) {
+            return transition(next,
+                    Effect.now(EffectType.CANCEL_TIMEOUT),
+                    Effect.now(EffectType.PLAY_STEP),
+                    Effect.command(EffectType.START_UPLOAD, state.firstPressNs),
+                    Effect.arm(next));
+        }
+        return transition(next,
+                Effect.now(EffectType.PLAY_STEP),
+                Effect.arm(next));
+    }
+
+    private static State waiting(
+            int pressCount, long firstPressNs, long lastPressNs, long revision) {
+        long deadlineNs = Math.min(
+                lastPressNs + MAX_GAP_NS,
+                firstPressNs + SEQUENCE_TIMEOUT_NS);
+        return new State(
+                Phase.WAITING_FOR_NEXT_LONG_PRESS,
+                pressCount,
+                firstPressNs,
+                lastPressNs,
+                deadlineNs,
+                revision);
+    }
+
+    private static State idleAfter(State state) {
+        return new State(Phase.IDLE, 0, 0L, 0L, 0L, state.revision + 1L);
+    }
+
+    private static Transition transition(State state, Effect... effects) {
+        return new Transition(state, Collections.unmodifiableList(Arrays.asList(effects)));
+    }
+
+    private static Transition unchanged(State state) {
+        return new Transition(state, Collections.emptyList());
+    }
+
+    private RootLensButtonReducer() {}
+}
