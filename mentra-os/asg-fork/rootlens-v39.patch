+
+public class RootLensFeedbackTest {
+  @Test
+  public void assetsFor_acceptsOnlySemanticAllowlist() {
+    assertThat(Arrays.asList(RootLensFeedback.assetsFor("capture_start_received")))
+        .containsExactly(AudioAssets.VIDEO_RECORDING_START, "rootlens/capture_start.mp3");
+    assertThat(Arrays.asList(RootLensFeedback.assetsFor("capture_stop_received")))
+        .containsExactly(AudioAssets.VIDEO_RECORDING_STOP, "rootlens/capture_stop.mp3");
+    assertThat(RootLensFeedback.assetsFor("capture_started")).isNull();
+    assertThat(RootLensFeedback.assetsFor("capture_saved"))
+        .isNull();
+    assertThat(Arrays.asList(RootLensFeedback.assetsFor("calibration_gesture_step")))
+        .containsExactly("click_sound.wav");
+    assertThat(Arrays.asList(RootLensFeedback.assetsFor("upload_started")))
+        .containsExactly("rootlens/upload_started.mp3");
+    assertThat(Arrays.asList(RootLensFeedback.assetsFor("upload_complete")))
+        .containsExactly("rootlens/upload_complete.mp3");
+    assertThat(Arrays.asList(RootLensFeedback.assetsFor("upload_unavailable")))
+        .containsExactly("rootlens/upload_unavailable.mp3");
+    assertThat(Arrays.asList(RootLensFeedback.assetsFor("calibration_instructions")))
+        .containsExactly("rootlens/calibration_instructions.mp3");
+    assertThat(RootLensFeedback.assetsFor("upload_paused")).isNull();
+    assertThat(RootLensFeedback.assetsFor("../../arbitrary.wav")).isNull();
+    assertThat(RootLensFeedback.assetsFor(null)).isNull();
+  }
+}
