+package com.mentra.asg_client.audio;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import android.content.Context;
+import android.media.AudioManager;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 30)
+public class FeedbackVolumeControllerTest {
+    @Test
+    public void ensureAudible_convergesToMaximumAndIsIdempotent() {
+        Context context = ApplicationProvider.getApplicationContext();
+        AudioManager audioManager =
+                (AudioManager) context.getSystemService(Context.AUDIO_SERVICE);
+        int maximum = audioManager.getStreamMaxVolume(AudioManager.STREAM_NOTIFICATION);
+        audioManager.setStreamVolume(AudioManager.STREAM_NOTIFICATION, 1, 0);
+
+        FeedbackVolumeController controller = new FeedbackVolumeController(audioManager);
+
+        assertThat(controller.ensureAudible()).isTrue();
+        assertThat(audioManager.getStreamVolume(AudioManager.STREAM_NOTIFICATION)).isEqualTo(maximum);
+        assertThat(controller.ensureAudible()).isFalse();
+        assertThat(audioManager.getStreamVolume(AudioManager.STREAM_NOTIFICATION)).isEqualTo(maximum);
+    }
+}
