@@ -0,0 +1,70 @@
+package com.mentra.asg_client.audio;
+
+import android.content.Context;
+import android.util.Log;
+
+import com.mentra.asg_client.io.hardware.core.HardwareManagerFactory;
+import com.mentra.asg_client.io.hardware.interfaces.IHardwareManager;
+
+/** Plays allowlisted RootLens feedback through the ASG-owned Mentra Live audio path. */
+public final class RootLensFeedback {
+  public static final String ACTION_PLAY = "io.rootlens.mentra.PLAY_ASG_FEEDBACK";
+  public static final String EXTRA_EVENT = "feedback_event";
+
+  private static final String TAG = "RootLensFeedback";
+
+  private RootLensFeedback() {}
+
+  /**
+   * Play one semantic feedback event. Arbitrary asset paths are deliberately not accepted.
+   *
+   * @return true when the event was accepted by the hardware audio owner
+   */
+  public static boolean play(Context context, String event) {
+    String[] assets = assetsFor(event);
+    if (assets == null) {
+      Log.w(TAG, "Ignoring unknown RootLens feedback event: " + event);
+      return false;
+    }
+
+    IHardwareManager hardwareManager = HardwareManagerFactory.getInstance(context);
+    if (!hardwareManager.supportsAudioPlayback()) {
+      Log.w(TAG, "Audio playback is unavailable for RootLens event: " + event);
+      return false;
+    }
+
+    Log.i(TAG, "Playing RootLens feedback: " + event);
+    hardwareManager.playAudioAssets(assets);
+    return true;
+  }
+
+  static String[] assetsFor(String event) {
+    if (event == null) {
+      return null;
+    }
+    switch (event) {
+      case "capture_start_received":
+        return new String[] {
+          AudioAssets.VIDEO_RECORDING_START, "rootlens/capture_start.mp3"
+        };
+      case "capture_stop_received":
+        return new String[] {
+          AudioAssets.VIDEO_RECORDING_STOP, "rootlens/capture_stop.mp3"
+        };
+      case "capture_failed":
+        return new String[] {"rootlens/capture_failed.mp3"};
+      case "calibration_gesture_step":
+        return new String[] {AudioAssets.CLICK_SOUND};
+      case "upload_started":
+        return new String[] {"rootlens/upload_started.mp3"};
+      case "upload_complete":
+        return new String[] {"rootlens/upload_complete.mp3"};
+      case "upload_unavailable":
+        return new String[] {"rootlens/upload_unavailable.mp3"};
+      case "calibration_instructions":
+        return new String[] {"rootlens/calibration_instructions.mp3"};
+      default:
+        return null;
+    }
+  }
+}
