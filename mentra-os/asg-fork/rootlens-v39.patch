+package com.mentra.asg_client.service.core;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import android.os.Handler;
+import android.os.Looper;
+
+import java.time.Duration;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.Shadows;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class TouchEventReconcilerTest {
+  @Test
+  public void request_retriesUntilHardwareAcceptsCommand() {
+    AtomicInteger attempts = new AtomicInteger();
+    TouchEventReconciler reconciler =
+        new TouchEventReconciler(
+            new Handler(Looper.getMainLooper()), () -> attempts.incrementAndGet() >= 3);
+
+    reconciler.request("test");
+    Shadows.shadowOf(Looper.getMainLooper()).idleFor(Duration.ofSeconds(2));
+
+    assertThat(attempts.get()).isEqualTo(3);
+  }
+
+  @Test
+  public void newerRequest_supersedesPendingRetrySeries() {
+    AtomicInteger attempts = new AtomicInteger();
+    TouchEventReconciler reconciler =
+        new TouchEventReconciler(
+            new Handler(Looper.getMainLooper()), () -> {
+              attempts.incrementAndGet();
+              return true;
+            });
+
+    reconciler.request("old", 1_000L);
+    reconciler.request("new");
+    Shadows.shadowOf(Looper.getMainLooper()).idleFor(Duration.ofSeconds(2));
+
+    assertThat(attempts.get()).isEqualTo(1);
+  }
+}
diff --git a/asg_client/app/src/test/java/com/mentra/asg_client/service/core/handlers/RootLensButtonReducerTest.java b/asg_client/app/src/test/java/com/mentra/asg_client/service/core/handlers/RootLensButtonReducerTest.java
new file mode 100644
index 0000000000..39d0ea0ad3
--- /dev/null
+++ b/asg_client/app/src/test/java/com/mentra/asg_client/service/core/handlers/RootLensButtonReducerTest.java
@@ -0,0 +1,144 @@
+package com.mentra.asg_client.service.core.handlers;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.Test;
+
+public class RootLensButtonReducerTest {
+    private static final long SECOND = 1_000_000_000L;
+
+    @Test
+    public void fivePressesWithinOriginalLimitsTriggerCalibrationOnly() {
+        RootLensButtonReducer.State state = RootLensButtonReducer.State.idle();
+        for (int index = 0; index < 5; index++) {
+            RootLensButtonReducer.Transition transition = reduce(
+                    state, RootLensButtonReducer.Event.longPress(index * 3L * SECOND));
+            state = transition.state;
+            if (index < 4) {
+                assertThat(effect(transition, RootLensButtonReducer.EffectType.ARM_TIMEOUT))
+                        .isNotNull();
+                assertThat(effect(transition, RootLensButtonReducer.EffectType.START_UPLOAD))
+                        .isNull();
+            } else {
+                assertThat(effect(transition, RootLensButtonReducer.EffectType.START_CALIBRATION))
+                        .isNotNull();
+                assertThat(effect(transition, RootLensButtonReducer.EffectType.START_UPLOAD))
+                        .isNull();
+                assertThat(state.phase).isEqualTo(RootLensButtonReducer.Phase.IDLE);
+            }
+        }
+    }
+
+    @Test
+    public void eachIncompletePrefixTimesOutToExactlyOneUpload() {
+        for (int presses = 1; presses < 5; presses++) {
+            RootLensButtonReducer.State state = RootLensButtonReducer.State.idle();
+            for (int index = 0; index < presses; index++) {
+                state = reduce(state,
+                        RootLensButtonReducer.Event.longPress(index * 2L * SECOND)).state;
+            }
+            long revision = state.revision;
+            RootLensButtonReducer.Transition timeout = reduce(
+                    state,
+                    RootLensButtonReducer.Event.timeout(revision, state.deadlineNs + 1L));
+            assertThat(effect(timeout, RootLensButtonReducer.EffectType.START_UPLOAD)).isNotNull();
+            assertThat(timeout.state.phase).isEqualTo(RootLensButtonReducer.Phase.IDLE);
+            assertThat(reduce(timeout.state,
+                    RootLensButtonReducer.Event.timeout(revision, state.deadlineNs + 2L)).effects)
+                    .isEmpty();
+        }
+    }
+
+    @Test
+    public void originalBoundaryValuesRemainInclusive() {
+        RootLensButtonReducer.State state = RootLensButtonReducer.State.idle();
+        long[] presses = {0L, 8L * SECOND, 16L * SECOND, 24L * SECOND, 30L * SECOND};
+        RootLensButtonReducer.Transition transition = null;
+        for (long press : presses) {
+            transition = reduce(state, RootLensButtonReducer.Event.longPress(press));
+            state = transition.state;
+        }
+        assertThat(effect(transition, RootLensButtonReducer.EffectType.START_CALIBRATION))
+                .isNotNull();
+        assertThat(effect(transition, RootLensButtonReducer.EffectType.START_UPLOAD)).isNull();
+
+        state = reduce(RootLensButtonReducer.State.idle(),
+                RootLensButtonReducer.Event.longPress(0L)).state;
+        transition = reduce(state,
+                RootLensButtonReducer.Event.longPress(8L * SECOND + 1L));
+        assertThat(effect(transition, RootLensButtonReducer.EffectType.START_UPLOAD)).isNotNull();
+    }
+
+    @Test
+    public void duplicateFirmwareReportDoesNotAdvanceOrExtendDeadline() {
+        RootLensButtonReducer.State state = reduce(
+                RootLensButtonReducer.State.idle(),
+                RootLensButtonReducer.Event.longPress(10L * SECOND)).state;
+        RootLensButtonReducer.Transition duplicate = reduce(
+                state, RootLensButtonReducer.Event.longPress(10L * SECOND + 999_999_999L));
+        assertThat(duplicate.state).isSameAs(state);
+        assertThat(duplicate.effects).isEmpty();
+        assertThat(state.deadlineNs).isEqualTo(18L * SECOND);
+
+        RootLensButtonReducer.Transition distinct = reduce(
+                state, RootLensButtonReducer.Event.longPress(11L * SECOND));
+        assertThat(distinct.state.pressCount).isEqualTo(2);
+    }
+
+    @Test
+    public void totalDeadlineOverridesTheNextEightSecondGap() {
+        RootLensButtonReducer.State state = RootLensButtonReducer.State.idle();
+        long[] presses = {0L, 8L * SECOND, 16L * SECOND, 24L * SECOND};
+        for (long press : presses) {
+            state = reduce(state, RootLensButtonReducer.Event.longPress(press)).state;
+        }
+        assertThat(state.deadlineNs).isEqualTo(30L * SECOND);
+    }
+
+    @Test
+    public void normalPressBeforeDeadlineCancelsButAfterDeadlineCatchesUpUpload() {
+        RootLensButtonReducer.State pending = reduce(
+                RootLensButtonReducer.State.idle(),
+                RootLensButtonReducer.Event.longPress(0L)).state;
+        RootLensButtonReducer.Transition before = reduce(
+                pending, RootLensButtonReducer.Event.normalPress(8L * SECOND));
+        assertThat(effect(before, RootLensButtonReducer.EffectType.START_UPLOAD)).isNull();
+        assertThat(effect(before, RootLensButtonReducer.EffectType.TOGGLE_CAPTURE)).isNotNull();
+
+        RootLensButtonReducer.Transition after = reduce(
+                pending, RootLensButtonReducer.Event.normalPress(8L * SECOND + 1L));
+        assertThat(effect(after, RootLensButtonReducer.EffectType.START_UPLOAD)).isNotNull();
+        assertThat(effect(after, RootLensButtonReducer.EffectType.TOGGLE_CAPTURE)).isNotNull();
+    }
+
+    @Test
+    public void staleAndEarlyTimeoutsCannotUpload() {
+        RootLensButtonReducer.State first = reduce(
+                RootLensButtonReducer.State.idle(),
+                RootLensButtonReducer.Event.longPress(0L)).state;
+        RootLensButtonReducer.State second = reduce(
+                first, RootLensButtonReducer.Event.longPress(2L * SECOND)).state;
+        assertThat(reduce(second,
+                RootLensButtonReducer.Event.timeout(first.revision, 20L * SECOND)).effects)
+                .isEmpty();
+
+        RootLensButtonReducer.Transition early = reduce(second,
+                RootLensButtonReducer.Event.timeout(second.revision, second.deadlineNs));
+        assertThat(effect(early, RootLensButtonReducer.EffectType.START_UPLOAD)).isNull();
+        assertThat(effect(early, RootLensButtonReducer.EffectType.ARM_TIMEOUT)).isNotNull();
+    }
+
+    private static RootLensButtonReducer.Transition reduce(
+            RootLensButtonReducer.State state, RootLensButtonReducer.Event event) {
+        return RootLensButtonReducer.reduce(state, event);
+    }
+
+    private static RootLensButtonReducer.Effect effect(
+            RootLensButtonReducer.Transition transition,
+            RootLensButtonReducer.EffectType type) {
+        for (RootLensButtonReducer.Effect effect : transition.effects) {
+            if (effect.type == type) return effect;
+        }
+        return null;
+    }
+}
