+package com.mentra.asg_client.service.core;
+
+/** Detects MCU traffic that may follow a case/suspend boundary and require state reconciliation. */
+final class PeripheralWakeBoundary {
+  private static final long IDLE_BOUNDARY_MS = 30_000L;
+
+  private long lastPacketElapsedMs = -1L;
+
+  synchronized boolean observe(long nowElapsedMs, String payload) {
+    boolean firstPacket = lastPacketElapsedMs < 0L;
+    boolean afterIdle = !firstPacket
+        && nowElapsedMs - lastPacketElapsedMs >= IDLE_BOUNDARY_MS;
+    lastPacketElapsedMs = nowElapsedMs;
+    return firstPacket || afterIdle || isBatteryBoundary(payload);
+  }
+
+  private static boolean isBatteryBoundary(String payload) {
+    return payload != null && payload.contains("\"C\":\"hm_batv\"");
+  }
+}
