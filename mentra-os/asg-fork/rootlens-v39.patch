@@ -0,0 +1,79 @@
+package com.mentra.asg_client.service.core;
+
+import android.os.Handler;
+import android.util.Log;
+
+/**
+ * Converges BES touch reporting to the enabled state after lifecycle and audio route changes.
+ *
+ * <p>The command is idempotent. A new request supersedes an older retry series, so callers can
+ * request reconciliation freely without building their own timing or retry state.
+ */
+final class TouchEventReconciler {
+  interface Sender {
+    boolean enableTouchReporting();
+  }
+
+  private static final String TAG = "TouchEventReconciler";
+  private static final long[] RETRY_DELAYS_MS = {0L, 250L, 1_000L, 3_000L};
+
+  private final Handler handler;
+  private final Sender sender;
+
+  private long generation;
+  private Runnable pending;
+
+  TouchEventReconciler(Handler handler, Sender sender) {
+    this.handler = handler;
+    this.sender = sender;
+  }
+
+  synchronized void request(String reason) {
+    request(reason, 0L);
+  }
+
+  synchronized void request(String reason, long initialDelayMs) {
+    long requestGeneration = ++generation;
+    cancelPending();
+    schedule(requestGeneration, reason, 0, Math.max(0L, initialDelayMs));
+  }
+
+  synchronized void cancel() {
+    ++generation;
+    cancelPending();
+  }
+
+  private synchronized void schedule(
+      long requestGeneration, String reason, int attempt, long delayMs) {
+    Runnable task = () -> attempt(requestGeneration, reason, attempt);
+    pending = task;
+    handler.postDelayed(task, delayMs);
+  }
+
+  private synchronized void attempt(long requestGeneration, String reason, int attempt) {
+    if (requestGeneration != generation) {
+      return;
+    }
+    pending = null;
+
+    if (sender.enableTouchReporting()) {
+      Log.i(TAG, "Touch reporting reconciled: " + reason + " attempt=" + (attempt + 1));
+      return;
+    }
+
+    int nextAttempt = attempt + 1;
+    if (nextAttempt >= RETRY_DELAYS_MS.length) {
+      Log.e(TAG, "Touch reporting reconciliation exhausted: " + reason);
+      return;
+    }
+    schedule(requestGeneration, reason, nextAttempt, RETRY_DELAYS_MS[nextAttempt]);
+  }
+
+  private void cancelPending() {
+    if (pending == null) {
+      return;
+    }
+    handler.removeCallbacks(pending);
+    pending = null;
+  }
+}
