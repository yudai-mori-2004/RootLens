# Solana / Anchor (Unit D 以降)
/target/
/.anchor/
test-ledger/
**/*.so
# program keypair はローカル保管。本番デプロイ前にチームで共有 keypair を作る
/target/deploy/*-keypair.json
# License Collection / USDC mint keypair も同じくローカル保管
keys/
# Anchor / license-cli が生成する bootstrap config (環境ローカル)
network.json
# setup スクリプトが devnet で生成する fixtures (= 各開発者ローカル artifact)。
# leaf owner の secret key を含むので絶対に commit しない。
tests/license-nft/fixtures.json
tests/license-nft/fixtures-canopy.json

# Vendored external reference repos (= 開発者ローカル参照、 sub-repo として持つ)。
# stera-sdk / ml-egodex / VisionProTeleop / Arvos など 600 MB 級なので commit しない。
references/
tests/license-nft/node_modules/

# Hand-pose module build artifacts
app/modules/hand-pose/android/build/

# LP sample 配信物 (= 元 .mp4 1.6 GB + 生成 dataset 554 MB)。
# git 管理せず、 R2 / 別配信経路で扱う。
# メタ JSON (json/rootlens_sample_videos.json) は contributor が付けた task ラベルで
# build スクリプトの入力なので git に残す。
web/public/lp/sample/*.mp4
web/public/lp/sample/dataset/

