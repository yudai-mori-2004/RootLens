*.hprof

# Next.js
web/.next/
web/out/

# Dev certificates (generated by scripts/gen-dev-certs.sh)
app/dev-certs/

# Native build artifacts

# Progress deck (local only)
progress/

# Misc
*.tsbuildinfo
.expo/
.claude

# Sensor session module build artifacts
app/modules/sensor-session/android/build/

# tools/ build artifacts
tools/**/__pycache__/
tools/**/*.pyc
tools/**/.venv/

# Rust build artifacts (どのクレートでも target/ は無視)
**/target/

# ローカル鍵置き場 (dev-only Solana deployer 等の履歴、 v0.1.4 以降は使わない)
keys/

# Vendored external reference repos (= 開発者ローカル参照、 sub-repo として持つ)。
# stera-sdk / ml-egodex / VisionProTeleop / Arvos など 600 MB 級なので commit しない。
references/
tests/license-nft/node_modules/

# Hand-pose module build artifacts
app/modules/hand-pose/android/build/

# LP sample 配信物 (= 元 .mp4 1.6 GB + 生成 dataset 554 MB)。
# git 管理せず、 R2 / 別配信経路で扱う。
# メタ JSON (json/rootlens_sample_videos.json) は contributor が付けた task ラベルで
# build スクリプトの入力なので git に残す。
web/public/lp/sample/*.mp4
web/public/lp/sample/dataset/


# iOS build artifacts (large, never commit)
*.ipa
app/build-*.ipa

# ローカル復旧バケットダンプ (生映像。 絶対 git に入れない)
recovered/
labelreview/
tmp_transcode/
/sample/

# hyphenbox 渡し用 zip (= 26 GB、 R2 で配布)
rootlens-sample-*.zip

# Cloudflare wrangler のローカル dev state (自動生成、 コミットしない)
.wrangler/

# ローカル raw ダウンロードの scratch (生映像を置く一時場所)
/raw/
